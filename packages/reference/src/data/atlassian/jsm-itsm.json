    {
      "id": "atl.jsm.itsm.workflow.service-request-fulfilment-with-approvals",
      "kind": "workflow",
      "product": "jsm",
      "name": "Service request fulfilment with approvals workflow",
      "partOf": "atl.jsm.template.itsm",
      "attributes": {
        "statuses": [
          {
            "name": "Waiting for support",
            "category": "IN_PROGRESS"
          },
          {
            "name": "Pending",
            "category": "IN_PROGRESS"
          },
          {
            "name": "Canceled",
            "category": "DONE"
          },
          {
            "name": "Escalated",
            "category": "IN_PROGRESS"
          },
          {
            "name": "In Progress",
            "category": "IN_PROGRESS"
          },
          {
            "name": "Closed",
            "category": "DONE"
          },
          {
            "name": "Waiting for customer",
            "category": "IN_PROGRESS"
          },
          {
            "name": "Resolved",
            "category": "DONE"
          },
          {
            "name": "Waiting for approval",
            "category": "TODO"
          }
        ],
        "approvalStatus": "Waiting for approval",
        "approverSource": "Approvers field",
        "captured": {
          "siteWorkflowName": "ZZREF: Service Request Fulfilment with Approvals workflow for Jira Service Management",
          "usedBy": [
            "Service Request with Approvals"
          ]
        },
        "initialStatus": "Waiting for approval",
        "transitions": [
          {
            "name": "Approved",
            "from": [
              "Waiting for approval"
            ],
            "to": "Waiting for support"
          },
          {
            "name": "Declined",
            "from": [
              "Waiting for approval"
            ],
            "to": "Resolved",
            "setsResolution": "Declined",
            "screen": true
          },
          {
            "name": "In progress",
            "from": [
              "Waiting for support",
              "Pending",
              "Waiting for customer",
              "Escalated"
            ],
            "to": "In Progress"
          },
          {
            "name": "Respond to customer",
            "from": [
              "Waiting for support",
              "In Progress",
              "Pending",
              "Escalated"
            ],
            "to": "Waiting for customer"
          },
          {
            "name": "Respond to support",
            "from": [
              "Waiting for customer"
            ],
            "to": "Waiting for support"
          },
          {
            "name": "Pending",
            "from": [
              "Waiting for support",
              "In Progress",
              "Waiting for customer",
              "Escalated"
            ],
            "to": "Pending"
          },
          {
            "name": "Escalate",
            "from": [
              "Waiting for support",
              "In Progress",
              "Pending",
              "Waiting for customer"
            ],
            "to": "Escalated"
          },
          {
            "name": "Resolve this issue",
            "from": [
              "Waiting for support",
              "In Progress",
              "Pending",
              "Waiting for customer",
              "Escalated"
            ],
            "to": "Resolved",
            "screen": true
          },
          {
            "name": "Cancel request",
            "from": [
              "Waiting for approval",
              "Waiting for support",
              "In Progress",
              "Pending",
              "Waiting for customer",
              "Escalated"
            ],
            "to": "Canceled",
            "screen": true
          }
        ]
      },
      "verification": {
        "status": "verified",
        "verifiedOn": "2026-10-15",
        "verifiedAgainst": "https://one-atlas-vish.atlassian.net (fresh ITSM space ZZREF / ITAM schema ZZITAM)",
