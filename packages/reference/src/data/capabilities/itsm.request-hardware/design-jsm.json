  {
    "id": "wf.service-request-approvals", "type": "workflow", "name": "Service request fulfilment with approvals", "origin": "reference",
    "referenceId": "atl.jsm.itsm.workflow.service-request-fulfilment-with-approvals",
    "spec": {
      "name": "Service request fulfilment with approvals workflow",
      "initialStatusId": "s.waiting-for-approval",
      "statuses": [
        { "id": "s.waiting-for-approval", "name": "Waiting for approval", "category": "TODO" },
        { "id": "s.waiting-for-support", "name": "Waiting for support", "category": "TODO" },
        { "id": "s.in-progress", "name": "In progress", "category": "IN_PROGRESS" },
        { "id": "s.waiting-for-customer", "name": "Waiting for customer", "category": "IN_PROGRESS" },
        { "id": "s.resolved", "name": "Resolved", "category": "DONE" },
        { "id": "s.declined", "name": "Declined", "category": "DONE" },
        { "id": "s.canceled", "name": "Canceled", "category": "DONE" }
      ],
      "transitions": [
        { "id": "t.approve", "name": "Approve", "from": ["s.waiting-for-approval"], "to": "s.waiting-for-support" },
        { "id": "t.decline", "name": "Decline", "from": ["s.waiting-for-approval"], "to": "s.declined" },
        { "id": "t.start", "name": "Start work", "from": ["s.waiting-for-support"], "to": "s.in-progress" },
        { "id": "t.ask-customer", "name": "Ask customer", "from": ["s.in-progress"], "to": "s.waiting-for-customer" },
        { "id": "t.customer-responded", "name": "Respond", "from": ["s.waiting-for-customer"], "to": "s.in-progress" },
        { "id": "t.resolve", "name": "Resolve", "from": ["s.in-progress"], "to": "s.resolved" },
        { "id": "t.cancel", "name": "Cancel request", "from": [], "to": "s.canceled" }
      ],
      "approvals": [
        { "atStatusId": "s.waiting-for-approval", "approvers": { "kind": "field", "fieldId": "fld.approvers" }, "decision": "one", "approveTransitionId": "t.approve", "declineTransitionId": "t.decline" }
      ]
    }
  },
  {
